<div class="container">
  <h1 class="section-title">Tags</h1>
  <% if tag_list.empty? %>
    <p class="empty">No tags yet.</p>
  <% else %>
    <ul class="tag-cloud">
      <% tag_list.each do |tag| %>
        <li>
          <a class="tag tag-large" href="<%= h(tag_url(tag)) %>"><%= h(tag) %> <span class="tag-count"><%= tags[tag].size %></span></a>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
