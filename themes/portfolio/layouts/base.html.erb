<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= h(page.title) %><%= page.url == "/" ? "" : " · #{h(config.title)}" %></title>
  <meta name="description" content="<%= h(page.description.to_s.empty? ? config.description : page.description) %>">
  <meta property="og:title" content="<%= h(page.title) %>">
  <meta property="og:description" content="<%= h(page.description.to_s.empty? ? config.description : page.description) %>">
  <meta property="og:url" content="<%= h(absolute_url(page.url)) %>">
  <meta property="og:type" content="website">
  <link rel="canonical" href="<%= h(absolute_url(page.url)) %>">
  <link rel="alternate" type="application/atom+xml" title="<%= h(config.title) %>" href="<%= h(feed_url) %>">
  <link rel="icon" href="<%= h(asset_url('favicon.svg')) %>" type="image/svg+xml">
  <link rel="stylesheet" href="<%= h(asset_url('style.css')) %>">
  <link rel="stylesheet" href="<%= h(asset_url('rouge.css')) %>">
</head>
<body>
  <header class="site-header">
    <div class="container header-inner">
      <a class="wordmark" href="<%= url('/') %>"><%= h(config.title) %></a>
      <nav class="site-nav" aria-label="Main navigation">
        <% config.menu.each do |item| %>
          <a href="<%= h(url(item['url'])) %>"><%= h(item['title']) %></a>
        <% end %>
      </nav>
    </div>
  </header>

  <main id="main">
    <%= content %>
  </main>

  <footer class="site-footer">
    <div class="container">
      <p>&copy; <%= Time.now.year %> <%= h(config.author.to_s.empty? ? config.title : config.author) %></p>
      <p class="footer-links">
        <% if config.email %><a href="mailto:<%= h(config.email) %>"><%= h(config.email) %></a><% end %>
        <% Array(config.social['github']).each do |handle| %><a href="https://github.com/<%= h(handle) %>" rel="noopener">GitHub</a><% end %>
        <a href="<%= h(feed_url) %>">RSS</a>
        <a href="https://github.com/nekonaru/quire" rel="noopener">Powered by Quire</a>
      </p>
    </div>
  </footer>
</body>
</html>
